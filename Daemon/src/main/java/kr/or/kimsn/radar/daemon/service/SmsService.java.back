package kr.or.kimsn.radar.daemon.service;

import java.util.ArrayList;
import java.util.List;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.core.env.ConfigurableEnvironment;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import kr.or.kimsn.radar.daemon.enums.*;
import kr.or.kimsn.radar.daemon.util.TimeUtil;
import kr.or.kimsn.radar.data.dto.*;

@Service
@Slf4j
@RequiredArgsConstructor
public class SmsService {

    private final QueryService queryService;
    private final ConfigurableEnvironment environment;

    @Transactional(rollbackFor = Exception.class)
    public void sendSmsNotifications(int gubun, String dataKindStr, int srCnt, List<StationDto> srDto, String gubunStr, String cycleId, String currentTime) {
        log.info("======================= 💬 문자 메시지 발송 조건 검증 가동 =================================");

        String globalPrefix = "radar.config.global.";
        String callFrom = environment.getProperty(globalPrefix + "call_from", "027337365");
        String templateCode = environment.getProperty(globalPrefix + "template_code", "radar_0001");
        
        AppTemplateCodeDto templateCodeDto = queryService.getTemplateCode(templateCode);
        String smsTitle = templateCodeDto != null ? templateCodeDto.getHead() : "레이더 알림";

        List<ReceiveConditionDto> rcDtoAll = queryService.getReceiveConditionList(dataKindStr, "NQC");
        List<StationStatusDto> siteStatusDtos = queryService.getStationStatusGubun(gubun);
        String dateTime = TimeUtil.getCurrentKstString();

        int recvTota = 0, recvTore = 0;
        String recvCode = "", recvCodeDtl = "";
        List<ReceiveConditionDto> rcActiveList = new ArrayList<>();
        
        for (ReceiveConditionDto rc : rcDtoAll) {
            if (rc.getSmsSendActivation() > 0) rcActiveList.add(rc);

            if (ReceiveConditionEnum.TOTA.getCode().equals(rc.getRecvCondition())) {
                recvCode = ReceiveConditionEnum.TOTA.getCode();
                recvCodeDtl = ReceiveCodeDtlEnum.NETWORK_NO.getCode();
                recvTota++;
            }
            if (ReceiveConditionEnum.TORE.getCode().equals(rc.getRecvCondition())) {
                recvCode = ReceiveConditionEnum.TORE.getCode();
                recvCodeDtl = ReceiveCodeDtlEnum.NETWORK_OK.getCode();
                recvTore++;
            }
        }

        // ====================================================
        // 파트 A: 전 사이트 일괄 알림 대조 발송 (전체 망 장애/복구)
        // ====================================================
        if (srDto.size() == recvTota || recvTore > 0) {
            List<SmsSendPatternDto> smsPatternDto = queryService.getSmsSendPattern(1, 1, recvCode, recvCodeDtl);
            String smsPetterns = "";

            // 💡 4중 루프 내부의 매칭 명세를 결합 조건으로 단순화하여 간소화 완료
            for (StationStatusDto status : siteStatusDtos) {
                if (status.getStatus() <= 0) continue;
                
                for (SmsSendPatternDto spDto : smsPatternDto) {
                    if (!status.getSiteStatus().equals(spDto.getMode())) continue;
                    
                    for (ReceiveConditionDto rcList : rcActiveList) {
                        if (rcList.getSite().equals(status.getSiteCd()) && rcList.getSmsSend() == 0) {
                            String sitePrefix = (recvCode.equals("TOTA") || recvCode.equals("TORE")) ? (gubunStr + " ") : "";
                            smsPetterns = sitePrefix + spDto.getPattern()
                                    .replace("%SITE%", status.getSiteName())
                                    .replace("%TIME%", dateTime);
                        }
                    }
                }
            }

            if (!smsPetterns.isEmpty()) {
                String titleAndText = smsTitle.replace("\n", "") + "\n\n" + smsPetterns;
                String resDate = dateTime.replaceAll("[^0-9]", ""); 

                List<SmsSendMemberDto> smsMembersDto = queryService.getSmsSendMemberList(dataKindStr, null);
                for (SmsSendMemberDto dto : smsMembersDto) {
                    if (dto.getSms() != 1) continue;
                    
                    boolean isMatch = (recvCode.equals("TOTA") && dto.getWarn() == 1)
                                   || (recvCode.equals("TORE") && dto.getRetr() == 1)
                                   || (recvCode.equals("RETR") && dto.getRetr() == 1);

                    if (isMatch) {
                        String callTo = dto.getPhone_num().replaceAll("-", "");
                        log.info("[🚀 파트A 문자 전송] 수신자: {}, 번호: {}, 내용: {}", dto.getName(), callTo, titleAndText);
                        
                        if (!callTo.isEmpty() && callTo.matches("[0-9]+")) {
                            queryService.intNuri2Save(resDate, callTo, callFrom, templateCode, smsTitle, titleAndText);
                        }
                    }
                }

                int second = 60 * 4 + 30;
                String previousTime = TimeUtil.getPreviousTimePattern(second);
                int lastDigit = Integer.parseInt(previousTime.substring(previousTime.length() - 1));
                previousTime = previousTime.substring(0, previousTime.length() - 1) + (lastDigit <= 5 ? "0" : "5");

                queryService.updateReceiveConditionSms(1, null, null, dataKindStr, "NQC");
            }
        }
        // ====================================================
        // 파트 B: 개별 지점별 단독 주의/품질이상/미수신 장애 통보
        // ====================================================
        if (recvCode.isEmpty()) {
            for (int a = 0; a < srCnt; a++) {
                String siteCd = srDto.get(a).getSiteCd();
                String siteStr = srDto.get(a).getNameKr();

                log.info("[============ {} 정보 ==============]", siteStr);

                StationStatusDto siteStatusDto = queryService.getStationStatus(siteCd);
                ReceiveConditionDto rcDto = queryService.getReceiveCondition(dataKindStr, "NQC", siteCd);

                if (rcDto.getRecvCondition().equals(ReceiveConditionEnum.ORDI.getCode())) {
                    log.info("[최종 상태 정상]");
                    continue; // 조기 종료로 들여쓰기 깊이 축소
                }

                // 알림 비활성화 또는 예외 그룹 상태일 경우 조기 스킵
                if (rcDto.getSmsSendActivation() != 1 
                        || rcDto.getRecvCondition().equals(ReceiveConditionEnum.TOTA.getCode()) 
                        || rcDto.getRecvCondition().equals(ReceiveConditionEnum.TORE.getCode())) {
                    continue;
                }

                String code = rcDto.getRecvCondition();
                String codedtl = rcDto.getCodedtl();
                int smsSend = rcDto.getSmsSend();

                log.info("[code] : {} | [code-dtl] : {}", code, codedtl);

                ReceiveConditionCriteriaDto rccDto = queryService.getReceiveConditionCriteria(gubun, code, codedtl);
                int criterion = rccDto.getCriterion();
                log.info("[{} '{}'회 체크]", rccDto.getName(), criterion);

                // 문자메시지 패턴 추출 레이어 단순화
                String smsPettern = "";
                List<SmsSendPatternDto> smsSendPatternDto = queryService.getSmsSendPattern(1, 1, code, codedtl);
                for (SmsSendPatternDto dto : smsSendPatternDto) {
                    if (siteStatusDto.getSiteStatus().equals(dto.getMode())) {
                        smsPettern = dto.getPattern().replace("%SITE%", siteStr).replace("%TIME%", dateTime);
                    }
                }
                // log.info("[문자메시지 패턴] : {}", smsPettern);

                if (smsPettern.isEmpty()) {
                    log.info("설정값에 따른 문자메시지 패턴 다시 확인 on/off");
                    continue;
                }

                // 💡 원래 요구 명세 규칙대로 인자값에 criterion 변수를 강력 고정 호출합니다.
                List<ReceiveDataDto> rdDto = queryService.getReceiveDataList(siteCd, dataKindStr, criterion);
                int cnt = 0; 
                
                if (rdDto != null && !rdDto.isEmpty()) {
                    for (ReceiveDataDto rd : rdDto) {
                        String recvCon = "";
                        String rcVal = rd.getRecv_condition(); // 💡 스네이크 표기법 교정 반영
                        
                        // DB 수집 이력 상태 매핑 테이블 축소
                        if ("RECV".equals(rcVal)) recvCon = ReceiveConditionEnum.ORDI.getCode(); 
                        else if ("MISS".equals(rcVal)) recvCon = ReceiveConditionEnum.WARN_MISS.getCode(); 
                        else if ("RETR".equals(rcVal)) recvCon = ReceiveConditionEnum.RETR.getCode(); 
                        else if ("TOTA".equals(rcVal)) recvCon = ReceiveConditionEnum.TOTA.getCode(); 
                        else if ("TORE".equals(rcVal)) recvCon = ReceiveConditionEnum.TORE.getCode(); 

                        // 가변 하이브리드 필터 가드 엔진 (동일 실패/복구 패밀리 판정)
                        boolean isBothFailureGroup = (code.equals(ReceiveConditionEnum.WARN_MISS.getCode()) || code.equals(ReceiveConditionEnum.TOTA.getCode())) 
                                && (recvCon.equals(ReceiveConditionEnum.WARN_MISS.getCode()) || recvCon.equals(ReceiveConditionEnum.TOTA.getCode()));
                        
                        boolean isBothRecoveryGroup = (code.equals(ReceiveConditionEnum.RETR.getCode()) || code.equals(ReceiveConditionEnum.TORE.getCode()) || code.equals(ReceiveConditionEnum.ORDI.getCode())) 
                                && (recvCon.equals(ReceiveConditionEnum.RETR.getCode()) || recvCon.equals(ReceiveConditionEnum.TORE.getCode()) || recvCon.equals(ReceiveConditionEnum.ORDI.getCode()));

                        if ((recvCon.equals(code) || isBothFailureGroup || isBothRecoveryGroup) && rccDto.getCodedtl().equals(rd.getCodedtl())) {
                            cnt++;
                        }
                    }
                }
                log.info("최종 산출 판정 건수 [cnt] : {} / 기준치 [criterion] : {}", cnt, criterion);

                if (criterion != cnt) {
                    log.info("[문자 전송 체크 - 기준자료] : {} | [문자 전송 체크 - data cnt] : {}", rccDto.getCriterion(), cnt);
                    log.info("문자 전송 안해도 됨");
                    continue;
                }

                if (smsSend != 0) {
                    log.info("[이미 문자 전송했음]");
                    continue;
                }

                // 담당자 발송 대상자 필터 제어문 집약 및 간소화
                String titleAndText = smsTitle.replace("\n", "") + "\n\n" + smsPettern;
                String resDate = dateTime.replaceAll("[^0-9]", "");
                List<SmsSendMemberDto> smsDto = queryService.getSmsSendMemberList(dataKindStr, siteCd);

                for (SmsSendMemberDto dto : smsDto) {
                    if (dto.getSms() == 1 && (code.equals("WARN") || code.equals("RETR") || code.equals("TOTA"))) {
                        String callTo = dto.getPhone_num().replace("-", "");
                        
                        log.info("[🚀 파트B 문자 전송] 수신자: {}, 번호: {}, 내용: {}", dto.getName(), callTo, titleAndText);
                        if (!callTo.isEmpty() && callTo.matches("[0-9]+")) {
                            queryService.intNuri2Save(resDate, callTo, callFrom, templateCode, smsTitle, titleAndText);
                        }
                    }
                }

                log.info("[문자 전송 여부 update]");
                smsSend = 1;
                int second = 60 * 4 + 30;
                
                // 최신 TimeUtil API 표준 규격으로 5분 단위 하향 절삭 동기화
                String previousTime = TimeUtil.getPreviousTimePattern(second);
                int lastDigit = Integer.parseInt(previousTime.substring(previousTime.length() - 1));
                previousTime = previousTime.substring(0, previousTime.length() - 1) + (lastDigit <= 5 ? "0" : "5");

                queryService.updateReceiveCondition(previousTime + "00", code, codedtl, smsSend, code, siteCd, dataKindStr, "NQC");
            }
        }
    }
}
