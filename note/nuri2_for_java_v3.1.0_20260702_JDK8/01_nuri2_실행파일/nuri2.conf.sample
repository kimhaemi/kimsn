#rcs_sign = ON

##########################################################################################################
# 전송 속도를 향상하기 위한 모드 변경
# 이 모드를 설정하면 전송 라인이 병렬로 동작을 하게 된다.
# 방화벽에서 동일한 서버로 여러 개의 Session 이 동작하는 것에 대해서 허용하도록 해야 한다.
# 예) xms_active_socket = 4     <-- SMS / MMS 전송 세션을 4개까지 늘려서 전송을 한다.(권장:5개 미만, 최대 10개)
#    alt_active_socket = 3      <-- KAKAO 알림톡 전송 세션을 3개까지 늘려서 전송을 한다.(권장:5개 미만, 최대 10개)
#    rcs_active_socket = 2      <-- RCS 전송 세션을 2개까지 늘려서 전송을 한다.(권장:5개 미만, 최대 10개)
#    rcs_active_socket = 1      <-- MO 전송 세션을 1개까지 늘려서 전송을 한다.(권장:5개 미만, 최대 10개)
#----------------------------------------------
# [*][중요]기본 값 설정 권장: 임의 변경 금지, 모바일메시지 운영팀에 문의 후 변경
#----------------------------------------------
#xms_active_socket = 1
#alt_active_socket = 1
#rcs_active_socket = 1
#----------------------------------------------
# [*][중요]기본 값 설정 권장: 임의 변경 금지, 모바일메시지 운영팀에 문의 후 변경
#----------------------------------------------

##########################################################################################################
# 전송 결과값을 빠르게 받기 위한 Receiver Multi (ON, OFF | 기본 : OFF)
# Receiver 가 Sender 와 Session 수량이 연결되게 동작을 하게 된다.
# 방화벽에서 동일한 서버로 여러 개의 Session 이 동작하는 것에 대해서 허용하도록 해야 한다.
# *_active_socket 설정에 따른 리포트세션 10개 설정시 리시버 5개 기동(1/2) 설정.
# 예) receiver_multi = ON
#----------------------------------------------
# [*][중요]기본 값 설정 권장: 임의 변경 금지, 모바일메시지 운영팀에 문의 후 변경
#----------------------------------------------
#receiver_multi = ON
#----------------------------------------------
# [*][중요]기본 값 설정 권장: 임의 변경 금지, 모바일메시지 운영팀에 문의 후 변경
#----------------------------------------------

##########################################################################################################
# Nuri2 재시작 시간 설정
# 모든 프로세스를 종료 후 재기동 함.
# 설정하지 않으면 재시작 하지 않음.
# (0100 ~ 2400) 분 단위까지 적용 가능.
# 예) 오전 7시 30분에 Nuri2 재시작하게 설정.
#    nuri_restart_time = 0730
#
#nuri_restart_time = 0730

##########################################################################################################
# Nuri2 REPORT 결과 갱신 (ON, OFF | 기본 : ON)
# NRMSG_DATA 에 결과 갱신할 값이 없으면
# 현재 달과 이전 달을 LOG 테이블을 각각 조회하여 결과 갱신하는 옵션
#
#report_follow_update = ON

##########################################################################################################
# log 테이블 이동 모드 (BATCH, REAL | 기본 : BATCH)
# BATCH : 전송 완료된 메시지를 일정 수량만큼 묶어서 처리
# REAL  : 전송 완료된 메시지를 실시간으로 log 테이블로 이동
# 예) nuri_log_mode = BATCH
#
#nuri_log_mode = REAL
nuri_log_mode = BATCH

##########################################################################################################
# log 테이블을 생성 형태 옵션 (LOG, LOG_YYYY, LOG_YYYYMM | 기본 : LOG_YYYYMM)
# *MSG_DATA에서 상태 값 MSG_STATE=6 또는 5(82시간 경과)인 데이터가 있을때 테이블이 생성됨.
# - 이동할 데이터가 있을 때
# LOG : log 테이블 하나만 생성함
# LOG_YYYY : log 테이블을 연단위(매년) 나누어 생성함
# LOG_YYYYMM : log 테이블을 연월단위(매월) 나누어 생성함
#
#nuri_log_make_mode = LOG_YYYYMM
# 예) [연월단위] 테이블 설정 : NRMSG_LOG_202601
#
#nuri_log_make_mode = LOG_YYYY
# 예) [연단위] 테이블 일때 : NRMSG_LOG_2026
#
#nuri_log_make_mode = LOG
# 예) [단일] 테이블 설정 : NRMSG_LOG

##########################################################################################################
# 결과 완료 값 log 테이블 이동 유무 설정 (ON, OFF | 기본 : ON)
# 결과 수신 완료 후 NRMSG_DATA 의 값을 NRMSG_LOG_YYYYMM 테이블로 이동 유무 설정
# db_log_move = OFF : 결과 수신 이후 log 테이블로 이동하지 않음
#
#db_log_move = ON

##########################################################################################################
# 레포트를 기다리는 시간 (단위 : 시간 | 기본 : 82)
# 이 시간이 지날 경우 더 이상 레포트를 기다리지 않고 해당레코드를 log 테이블로 이동시킨다.
#
#----------------------------------------------
# [*][중요]기본 값 설정 권장: 임의 변경 금지, 모바일메시지 운영팀에 문의 후 변경
#----------------------------------------------
#record_life_time = 82
#----------------------------------------------
# [*][중요]기본 값 설정 권장: 임의 변경 금지, 모바일메시지 운영팀에 문의 후 변경
#----------------------------------------------

##########################################################################################################
# Agent 의 장애 시 동작 지속 시간 추가 (단위 : 시간  | 기본 : 0)
# Socket 및 DB 연결이 안 되고 장애가 발생하고 있을 때 동작 지속 시간이
# 초과하면 Agent 의 기동을 모두 중지함
# 생략 시 0시간
# 해당 장애시간에 상관없이 계속 연결을 원할 시 0시로 입력
# 예) nuri_life_time = 168 (168시간 : 7일 동안 동작을 지속하고도 장애 시 Agent 종료함)
#     nuri_life_time = 0 (장애가 있어 연결이 안 되고 있어서 Agent 의 동작을 계속 유지함)
#nuri_life_time = 0

##########################################################################################################
# 사용하는 테이블의 사용자를 지정하는 옵션
# 사용하지 않을 시 "... FROM 테이블명 ..." 형식이지만
# 사용 시 "... FROM 테이블사용자.테이블명 ..." 형식으로 질의를 한다.
#
# db_select_user = 테이블의 사용자명
#
#db_select_user =

##########################################################################################################
# 데이터베이스의 전송 값의 조회시 사용할 Index Hint 명 (기본 : IDX_NRMSG_DATA_02)
# Oracle, MSSQL, MySQL, MariaDB, PostgreSQL, CUBRID, Tibero, Altibase, Db2 중
# Index Hint 지원 : Oracle, MSSQL, MySQL, MariaDB, Tibero, Altibase
# Index Hint 미지원 : PostgreSQL, CUBRID
#
# 예) db_hint = IDX_NRMSG_DATA_02
#
#db_hint = IDX_NRMSG_DATA_02

##########################################################################################################
# 사용하는 테이블명을 변경하는 옵션
# Oracle, MSSQL, MySQL, MariaDB, PostgreSQL, CUBRID, Tibero, Altibase, Db2 중
# *테이블 명을 소문자로 사용 : MySQL, MariaDB, PostgreSQL, CUBRID
#
# 기존에 테이블명을 사용자가 임의의 테이블명으로 변경할 수 있다.
# ------------------------------
# ■ 누리 테이블 설명
# NRMSG_DATA(OR NURI2_NRMSG_DATA) : [필수]메시지 전송 테이블, 발송하려는 메시지를 입력
# NRMSG_RSLT(OR NURI2_NRMSG_RSLT) : [필수]전송 결과 코드정보 테이블, 해당 테이블에 RSLT_CODE 를 조회 하여 RSLT_EXPLA 참고, 값 수정 가능
# NRMSG_LOG(OR NRMSG_LOG_YYYYMM)  : MSG_STATE='6'(상태완료)인 메시지를 저장하는 테이블(NRMSG_DATA 와 컬럼(필드)이 같음), (NURI2_)NRMSG_DATA 에서는 삭제 (NURI2_)NRMSG_LOG(_YYYYMM) 로 이동됨.
# [선택]
# NRMSG_DUPLEX(OR NURI2_NRMSG_DUPLEX) : 이중화 설정시에만 생성됨(자동생성, 권장), nuri2.conf에서 'duplex_switch = ON'으로 설정한 경우 생성(*속성 절대 수정불가)
#
# ------------------------------
# ■ 누리2가 최초 기동시 생성하는 테이블은 2개. 옵션에 따라 다름
# - NRMSG_DATA(OR NURI2_NRMSG_DATA), NRMSG_RSLT(OR NURI2_NRMSG_RSLT) 와 같이 기본적으로 생성
# - NRMSG_LOG(OR NRMSG_LOG_YYYYMM)테이블은 결과 수신 이후 생성됨(성공, 실패 확인)
# ------------------------------
#
# 아래 예와 같이 설정을 하면
# NRMSG_DATA_2, NRMSG_LOG_2, NRMSG_RSLT_2, NRMSG_DUPLEX_2 와 같이 생성되어 Nuri 가 기동된다.
# 예) db_table_name.NRMSG_DATA = NRMSG_DATA_2
#     db_table_name.NRMSG_LOG = NRMSG_LOG_2
#         db_table_name.NRMSG_RSLT = NRMSG_RSLT_2
#         db_table_name.NRMSG_DUPLEX = NRMSG_DUPLEX_2
#
####[기본 테이블명][초기테이블명]
# db_table_name.NRMSG_DATA = NRMSG_DATA
# db_table_name.NRMSG_LOG = NRMSG_LOG
# db_table_name.NRMSG_RSLT = NRMSG_RSLT
# db_table_name.NRMSG_DUPLEX = NRMSG_DUPLEX
#
####[■권장][기본 테이블명][Oracle][Tibero][Altibase]는 대문자 테이블명으로 변경 필요.
db_table_name.NRMSG_DATA = NURI2_NRMSG_DATA
db_table_name.NRMSG_LOG = NURI2_NRMSG_LOG
db_table_name.NRMSG_RSLT = NURI2_NRMSG_RSLT
db_table_name.NRMSG_DUPLEX = NURI2_NRMSG_DUPLEX
#
###[■권장][기본 테이블명][MySQL][MariaDB][CUBRID][PostgreSQL]는 소문자 테이블명으로 변경 필요.
# db_table_name.NRMSG_DATA = nuri2_nrmsg_data
# db_table_name.NRMSG_LOG = nuri2_nrmsg_log
# db_table_name.NRMSG_RSLT = nuri2_nrmsg_rslt
# db_table_name.NRMSG_DUPLEX = nuri2_nrmsg_duplex

##########################################################################################################
# 사용하는 시퀀스 명을 변경하는 옵션
# Oracle, MSSQL, MySQL, MariaDB, PostgreSQL, CUBRID, Tibero, Altibase, Db2 중
# 시퀀스 지원 : Oracle, Tibero, Altibase
# 시퀀스 미지원 : MSSQL, MySQL, MariaDB, PostgreSQL, CUBRID, Db2
# 기존에 시퀀스 명을 사용자가 임의의 시퀀스 명으로 변경할 수 있다.
# 아래 예와 같이 설정을 하면
# NRMSG_DATA_SEQ, NRMSG_RSLT_SEQ, NRMSG_DUPLEX_SEQ 와 같이 기본적으로 생성되는 시퀀스 명이
# NRMSG_DATA_SEQ_2, NRMSG_RSLT_SEQ_2, NRMSG_DUPLEX_SEQ_2 와 같이 생성되어 Nuri 가 기동된다.
# 예) db_sequence_name.NRMSG_DATA = NRMSG_DATA_SEQ_2
#        db_sequence_name.NRMSG_RSLT = NRMSG_RSLT_SEQ_2
#        db_sequence_name.NRMSG_DUPLEX = NRMSG_DUPLEX_SEQ_2
#
#db_sequence_name.NRMSG_DATA = NRMSG_DATA_SEQ
#db_sequence_name.NRMSG_RSLT = NRMSG_RSLT_SEQ
#db_sequence_name.NRMSG_DUPLEX = NRMSG_DUPLEX_SEQ

##########################################################################################################
# 사용자 정의 컬럼 설정 입니다.
##########################################################################################################
# 데이터베이스의 사용자 필드, 사용자 인덱스 추가 가능한 총량
# 필드 및 인덱스는 최대 10개만 가능하다.
# 예) db_max_count = 5  <-- db_field, db_index 를 5개 이상 설정해 놓아도 5개까지만 추가가 된다.(최대 10개)
# * 컬럼을 추가하려면 반드시 지정해야함
db_max_count = 10

##########################################################################################################
# 사용자 정의 컬럼 설정 입니다.
# -[중요] 아래 설정을 하셔야 사용자가 입력한 값이 NRMSG_DATA 에서 NRMSG_LOG 테이블로 같이 이관 됩니다.
# -[중요] 최초설정에 한해 반영되며, 운영중에 컬럼을 추가 한 경우에도 설정을 해야합니다.
##########################################################################################################
# 데이터베이스의 사용자 필드 추가 옵션
# 생성할 필드명과 데이터 타입 및 옵션 사이엔 스페이스로 구분해 줘야 한다.
# 아래 예와 같이 설정을 하면 4개의 필드가가 생성되며
# 테이블 맨 마지막에 MSG_ETC1 ~ MSG_ETC4  필드가 추가된다.
# 예) db_field = MSG_ETC1 varchar(10)
#     db_field = MSG_ETC2 varchar(10)
#     db_field = MSG_ETC3 VARCHAR(10)
#     db_field = MSG_ETC4 CHAR(1) NULL DEFAULT 'N'
# * 컬럼을 추가하려면 반드시 지정해야함
# * 컬럼명 속성(LENGTH) NULL유무 기본값
#
# # 각각 DBMS 맞게 설정 필요
#
# 아래 예제는 mysql & mariaDB 예) 입니다.
# db_field = MSG_ETC1 VARCHAR(10)  DEFAULT NULL
# db_field = MSG_ETC2 CHA(10) NULL DEFAULT 'N'
# db_field = MSG_ETC3 int(10)  DEFAULT NULL
# db_field = MSG_ETC4 datetime NOT NULL DEFAULT '0000-00-00 00:00:00'
#
# # Oracle 의 예
# db_field = MSG_ETC1 VARCHAR2(10)  NULL
# db_field = MSG_ETC2 CHAR(3)  NULL
# db_field = MSG_ETC3 NUMBER(10)  NULL
# db_field = MSG_ETC4 DATE DEFAULT SYSDATE

##########################################################################################################
# 데이터베이스의 사용자 인덱스 추가 옵션
# 생성할 인덱스의 필드와 필드 사이는 콤마로 구분해 줘야 하며
# 정렬( 오름차순:ASC, 내림차순:DESC) 도 설정할 수 있다.
# 아래 예와 같이 설정을 하면 3개의 인덱스가 생성되며
# 인덱스 명은 "IDX_로그테이블명_순서"로 생성이 된다.
# 예) db_index = MSG_KEY
#     db_index = CUR_STATE DESC, REQ_DATE ASC
#     db_index = CALL_TO
# 원하시는 컬럼에 인덱스 설정.
# db_index = MSG_KEY
# db_index = MSG_ETC1
# db_index = MSG_ETC2
# db_index = MSG_ETC3
# db_index = MSG_ETC4

##########################################################################################################
# 전송 데이터 조회 시간 (단위 : 초 | 기본 : 1)
#
#db_tran_term = 1

##########################################################################################################
# DBMS 의 연결 유지를 의한 조회 시간 (단위 : 초 | 기본 : 60)
# 커넥션 유효 쿼리는 각 DBMS 의 테이블명 조회 방식을 사용함
#
#db_ping_term = 60

##########################################################################################################
# DBMS 연결 요청 대기 시간 ( 단위 : 초 | 기본 : 30 / -1 = 무한정)
