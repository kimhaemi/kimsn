#######################################################
## 연동설정, xMS(문자), ALT(카카오), RCS(안심문자)
#######################################################
# *[중요][경고]제발 포트 10000으로 임의변경 하지 마세요.
# * 연동포트 임의변경 금지! 모바일메시지 서비스에 문의 후 변경 하세요!!!
# *[중요][경고]제발 포트 10000으로 임의변경 하지 마세요.(모바일메시지운영 안내시에만 변경하세요)
# *[중요][경고]제발 포트 10000으로 임의변경 하지 마세요.(모바일메시지운영 안내시에만 변경하세요)
#################################
# * 연동IP정보 인터넷망, 업무망 구분
# ★ 모바일메시지 운영에 문의
# 업무망 : 10.*.*.235
# 인터넷 : 125.*.*.20
#################################
# * '▶  ◀' 부분을 지우고 입력
#######################
##■ [xMS]문자메시지 서버 설정
#######################
xms_ip = ▶연동IP◀
# [▽▽▽▽▽▽▽][임의 변경금지]운영 승인 전까지 절대로 금지
xms_port = 20000
# [△△△△△△△][임의 변경금지]운영 승인 전까지 절대로 금지
xms_id = ▶연동계정◀
xms_pwd = ▶비밀번호◀
xms_link = OFF

#######################
##■ [ALT]앱메시지(KAKAO) 서버 설정
#######################
alt_ip = ▶연동IP◀
# [▽▽▽▽▽▽▽][임의 변경금지]운영 승인 전까지 절대로 금지
alt_port = 40000
# [△△△△△△△][임의 변경금지]운영 승인 전까지 절대로 금지
alt_id = ▶연동계정◀
alt_pwd = ▶비밀번호◀
alt_link = OFF

#######################
##■ [RCS]인증(안심)문자 서버 설정
#######################
rcs_ip = ▶연동IP◀
# [▽▽▽▽▽▽▽][임의 변경금지]운영 승인 전까지 절대로 금지
rcs_port = 40000
# [△△△△△△△][임의 변경금지]운영 승인 전까지 절대로 금지
rcs_id = ▶연동계정◀
rcs_pwd = ▶비밀번호◀
rcs_link = OFF

##########################################################################################################
#모바일메시지서비스 Agent Line별 설정[xMS/ALT/RCS] : 작동 여부 (ON, OFF | 기본 : ON)
#■기본값은 ON 입니다. 주석 '#'처리되있으면 'ON' 입니다
##########################################################################################################
# xms_sender : SMS / MMS Sender
# xms_receiver : SMS / MMS receiver
# alt_sender : KAKAO 알림톡 Sender
# alt_receiver : KAKAO 알림톡 receiver
# rcs_sender : RCS Sender
# rcs_receiver : RCS receiver
#(기본값은 ON 입니다. OFF일때만 주석을 제거 해주세요.)
#[*][매우중요] Sender 와 receiver는 한쌍(조)입니다. 반드시 동시 설정 해주세요.
#[*][매우중요] Sender 와 receiver는 한쌍(조)입니다. 반드시 동시 설정 해주세요.
#[*][매우중요] Sender 와 receiver는 한쌍(조)입니다. 반드시 동시 설정 해주세요.
#[*][매우중요] Sender 와 receiver는 한쌍(조)입니다. 반드시 동시 설정 해주세요.
# ===========================================
#[*]문자(XMS)만 사용하는 기관은 ALT/RCS를 OFF
#
# ===========================================
#■기본값은 ON 입니다. 주석 '#'처리되있으면 'ON' 입니다
# * xms는 끄지 마세요.(기본)
#xms_sender = OFF
#xms_receiver = OFF
# ===========================================
# 앱메시지(KAKAO)를 사용하는 경우 수정 금지
# - 알림톡(ALT, KAKAO) 미사용시 반드시 주석('#')을 삭제 하세요.
# ===========================================
#■기본값은 ON 입니다. 주석 '#'처리되있으면 'ON' 입니다
#alt_sender = OFF
#alt_receiver = OFF
# ===========================================
# RCS를 사용하는 경우에는 주석('#') 처리
# - RCS 미사용시 반드시 주석('#')을 삭제 하세요.
# ===========================================
#■기본값은 ON 입니다. 주석 '#'처리되있으면 'ON' 입니다
#rcs_sender = OFF
#rcs_receiver = OFF
#[*][매우중요] Sender 와 receiver는 한쌍(조)입니다. 반드시 동시 설정 해주세요.
#[*][매우중요] Sender 와 receiver는 한쌍(조)입니다. 반드시 동시 설정 해주세요.
#[*][매우중요] Sender 와 receiver는 한쌍(조)입니다. 반드시 동시 설정 해주세요.
#[*][매우중요] Sender 와 receiver는 한쌍(조)입니다. 반드시 동시 설정 해주세요.
##########################################################################################################



##########################################################################################################
# 데이터베이스 유형(db_name)
# Oracle, MSSQL, MySQL, MariaDB, PostgreSQL, CUBRID, Tibero, Altibase, DB2
#
# Database Driver
#
##########################################################
## ORACLE
# db_name = ORACLE
# db_driver = oracle.jdbc.driver.OracleDriver
# db_url = jdbc:oracle:thin:@DB서버주소:1521:ORACLESID
# db_url = jdbc:oracle:thin:@DB서버주소:1521:ORACLESID?useUnicode=true&characterEncoding=UTF-8
# RCS(이중화설정)
# db_url = jdbc:oracle:thin:@(DESCRIPTION=(ADDRESS_LIST=(ADDRESS=(PROTOCOL=TCP)(HOST=서버1)(PORT=1521))(ADDRESS=(PROTOCOL=TCP)(HOST=서버2)(PORT=1521))(FAILOVER=ON)(LOAD_BALANCE=ON))(CONNECT_DATA=(SERVER=DEDICATED)(SERVICE_NAME=서비스명)))
#
##########################################################
## MSSQL
# db_name = MSSQL
# db_driver = net.sourceforge.jtds.jdbc.Driver
# db_url = jdbc:jtds:sqlserver://DB서버주소:1433/데이터베이스명;charset=utf-8
# db_url = jdbc:jtds:sqlserver://DB서버주소:1433/데이터베이스명;encrypt=true;trustServerCertificate=true;useUnicode=true;characterEncoding=UTF-8
#
##########################################################
## MSSQL
# db_name = MSSQL
# db_driver = com.microsoft.sqlserver.jdbc.SQLServerDriver
# db_url = jdbc:sqlserver://DB서버주소:1433;databaseName=데이터베이스명;encrypt=true;trustServerCertificate=true;useUnicode=true
# db_url = jdbc:sqlserver://DB서버주소:1433;databaseName=데이터베이스명;encrypt=true;trustServerCertificate=true;useUnicode=true;characterEncoding=UTF-8
#
##########################################################
## MYSQL
# db_name = MYSQL
# db_driver = com.mysql.cj.jdbc.Driver
# db_url = jdbc:mysql://DB서버주소:3306/데이터베이스명?useCursorFetch=true&zeroDateTimeBehavior=CONVERT_TO_NULL&sslMode=DISABLED&characterEncoding=UTF-8
# db_url = jdbc:mysql://DB서버주소:3306/데이터베이스명?autoReconnect=true&useUnicode=true&zeroDateTimeBehavior=convertToNull&useSSL=false
# db_url = jdbc:mysql://DB서버주소:3306/데이터베이스명?autoReconnect=true&useUnicode=true&zeroDateTimeBehavior=convertToNull&useSSL=false&characterEncoding=utf8
#
##########################################################
## MARIADB
# db_name = MARIADB
# db_driver = org.mariadb.jdbc.Driver
# db_url = jdbc:mariadb://DB서버주소:3306/데이터베이스명?sslMode=disable&connectionTimeZone=Asia/Seoul
# db_url = jdbc:mariadb://DB서버주소:3306/데이터베이스명?autoReconnect=true&useUnicode=true&useSSL=false&serverTimezone=UTC
# db_url = jdbc:mariadb://DB서버주소:3306/데이터베이스명?autoReconnect=true&useUnicode=true&useSSL=false&serverTimezone=UTC&characterEncoding=utf8
#
##########################################################
## PostgreSQL
## PostgreSQL 은 테이블 명을 소문자로 사용하기 때문에 아래 db_table_name.NRMSG_XXX 옵션 값을 소문자로 변경해 사용해야 합니다.
# db_name = POSTGRESQL
# db_driver = org.postgresql.Driver
# db_url = jdbc:postgresql://DB서버주소:5432/데이터베이스명?currentSchema=사용자스키마
# db_url = jdbc:postgresql://DB서버주소:5432/데이터베이스명?currentSchema=사용자스키마&charSet=UTF-8
#
##########################################################
## CUBRID
## CUBRID 은 테이블 명을 소문자로 사용하기 때문에 아래 db_table_name.NRMSG_XXX 옵션 값을 소문자로 변경해 사용해야 합니다.
# db_name = CUBRID
# db_driver = cubrid.jdbc.driver.CUBRIDDriver
# db_url = jdbc:cubrid:DB서버주소:33000:데이터베이스명:::?charSet=utf-8
# db_url = jdbc:cubrid:DB서버주소:33000:데이터베이스명:::&altHosts=192.168.22.31:33000
# db_url = jdbc:cubrid:DB서버주소:33000:데이터베이스명:::?charEncoding=UTF-8
#
##########################################################
## TIBERO
# db_name = TIBERO
# db_driver = com.tmax.tibero.jdbc.TbDriver
# db_url = jdbc:tibero:thin:@DB서버주소:8629:데이터베이스명
# db_url = jdbc:tibero:thin:@DB서버주소:8629:데이터베이스명?useUnicode=true&characterEncoding=UTF-8
#
##########################################################
## ALTIBASE
# db_name = ALTIBASE
# db_driver = Altibase.jdbc.driver.AltibaseDriver
# db_url = jdbc:Altibase://DB서버주소:20300/데이터베이스명
# db_url = jdbc:Altibase://DB서버주소:20300/데이터베이스명?useUnicode=true&characterEncoding=UTF-8
#
##########################################################
## IBM DB2 # 2025-01-13
# db_name = DB2
# db_driver = com.ibm.db2.jcc.DB2Driver
# db_url = jdbc:db2://DB서버주소:50000/데이터베이스명
# db_url = jdbc:db2://DB서버주소:50000/데이터베이스명:useUnicode=true;characterEncoding=UTF-8;
#
##########################################################
## MySql, MariaDB 공통사용 가능
##db_name = MYSQL
##db_driver = com.mysql.cj.jdbc.Driver
##db_url = jdbc:mysql://localhost:3306/데이터베이스명?autoReconnect=true&useUnicode=true&zeroDateTimeBehavior=convertToNull&useSSL=false&characterEncoding=euckr
###############
