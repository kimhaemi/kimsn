#----------------------------------------------

##########################################################################################################
# The time when sender query to DBMS
# "ORDER BY NRMSG_DATA.MSG_KEY" 사용 여부 (ON, OFF | 기본 : ON)
# SELECT 시 ORDER BY NRMSG_DATA.MSG_KEY 를 사용하면
# DB 서버에 부하가 약간 생기는 문제로 업체가 요청한 옵션.
# OFF 하면 SELECT 시 CUR_STATE = 1의 값을 무작위로 가져오므로
# 메시지 사이사이 늦게 전송되는 것이 있음.
#
# db_orderby  : "ORDER BY NRMSG_DATA.MSG_KEY" 사용여부 (ON, OFF)
#
#db_orderby = ON

##########################################################################################################
# The time when create table query to DBMS
# Create Table, Create Index 체크 및 생성 사용 여부 (ON, OFF | 기본 : ON)
# ON : Create Table, Create Index 체크 및 생성 여부 사용함
# OFF : Create Table, Create Index 체크 및 생성 여부 사용 안 함
#
# db_create_table  : Create Table, Create Index 체크 및 생성 사용 여부 (ON, OFF)
#
#db_create_table = OFF

##########################################################################################################
# The time when create table query to DBMS
# Create Sequence 체크 및 생성 사용 여부 (ON, OFF | 기본 : ON)
# ON : Create Sequence 체크 및 생성 여부 사용함
# OFF : Create Sequence 체크 및 생성 여부 사용  안함
#
# db_create_sequence  : Create Sequence 체크 및 생성 사용 여부 (ON, OFF)
#
#db_create_sequence = OFF

################################################################################################
# MySQL, MariaDB 전용 옵션 (MyISAM, InnoDB)
# MySQL TABLE 생성 시 Engine 타입 설정
# 설정 안 하면 MySQL 기본 설정에 따라 Engine Type 생성
# "SELECT engine, support FROM information_schema.engines" 질의 시 support 가 default 로 되어 있는 engine
#
#db_storage_engine = InnoDB

##########################################################################################################
# 메시지 타입별 CharSet
# 각각의 메시지 타입별로 G/W 에 전송할 Charset 을 설정할 수 있다.
# 고도화 서버는 모두 UTF-8 기본 값
# 이전 SMS, MMS 서버는 EUC-KR
# locale -a |grep ko
#----------------------------------------------
# 한글이 깨지는 경우 아래와 같이 설정도 가능
# charset_xxx = ko_KR.utf8
# charset_xxx = ko_KR.eucKR
# charset_xxx = EUC-KR
#----------------------------------------------
# [*][중요]기본 값 설정 권장: 임의 변경 금지, 모바일메시지 운영팀에 문의 후 변경
#----------------------------------------------
#charset_sms = EUC-KR
#charset_mms = EUC-KR
#charset_alt = UTF-8
#charset_rcs = UTF-8
#----------------------------------------------
# [*][중요]기본 값 설정 권장: 임의 변경 금지, 모바일메시지 운영팀에 문의 후 변경
#----------------------------------------------


##########################################################################################################
# 메시지 MSG_TYPE 별 CONTENTS_TYPE_1 ~ 3
# CONTENTS_TYPE_1 ~ 3 에 들어가는 전송 타입으로 KAKAO 알림톡, RCS 는 계속 추가 예정
# MSG_TYPE_1 ~ 3 : SMS 이면 CONTENTS_TYPE_1 ~ 3 : SMS 만 입력
# MSG_TYPE_1 ~ 3 : MMS 이면 CONTENTS_TYPE_1 ~ 3 : LMS,MMS 만 입력
# MSG_TYPE_1 ~ 3 : ALT 이면 CONTENTS_TYPE_1 ~ 3 : ALT,ALI,FRT,FRI,FRW 만 입력
# MSG_TYPE_1 ~ 3 : RCS 이면 CONTENTS_TYPE_1 ~ 3 : RCS,RCL,RCM,RCT,RCD,RCF,RIT 만 입력
#
#----------------------------------------------
# [*][중요]기본 값 설정 권장: 임의 변경 금지, 모바일메시지 운영팀에 문의 후 변경
#----------------------------------------------
#msg_type.SMS = SMS
#msg_type.MMS = LMS,MMS
#msg_type.ALT = ALT,ALI,FRT,FRI,FRW
#msg_type.RCS = RCS,RCL,RCM,RCT,RCD,RCF,RIT
#----------------------------------------------
# [*][중요]기본 값 설정 권장: 임의 변경 금지, 모바일메시지 운영팀에 문의 후 변경
#----------------------------------------------

##########################################################################################################
# 모바일메시지서비스 G/W 와 연결 장애 시 실패 사용 여부 (ON, OFF | 기본 : OFF)
# xxx_sender = ON 인 상태에서 각 메시지 타입별 sender 에 문제가 발생했을 때 적용되는 옵션으로
# 메시지 전송 시 재전송으로 입력한 경우 실패 값으로 처리하여 2번째 또는 3번째 메시지로 전송하게 한다.
# OFF: 1번째 MSG_TYPE으로 성공 할 때까지 시도, 전송할 메시지의 상태 값(MSG_STATE) 6, 결과 코드(RSLT_CODE) 990 으로 모두 실패 처리
# ON : 2번째 또는 3번째 메시지로 전송.
#sender_failure_switch = ON

##########################################################################################################
# 하루에 한 수신번호에 보낼 수 있는 메시지 수량 (기본 : 10개)
# 생략 시 10개
# 0개로 세팅 시 사용 안 함
# # 메시지 내용과 상관 없이 동일 폰번호에 나가는 건수.
duplicate_phone_count = 400

##########################################################################################################
# Limit Time Zone (전송 제한 시간대 설정)
# 전송 제한 시작 시간 (0100 ~ 2400) 분 단위까지 적용 가능, 생략 시 24시간 전송 가능.
# 예) limit_begin = 2100
# 예) limit_end = 0600
#
#limit_begin =
#limit_end =

##########################################################################################################
# 현재 시간으로부터 설정 시간(RES_DATE 입력 시간) 이전 시간까지만 전송 (단위 : 시간 | 기본 : 3)
# 생략 시 3시간
#
#before_time = 3

##########################################################################################################

##########################################################################################################
#★★★ 중요 이중화는 아래 설정을 참조하세요. 자세한 설명은 모바일메시지 운영에 문의 하세요.
##########################################################################################################
# Active / Stand By 이중화 사용 여부 (ON, OFF | 기본 : OFF)
# - 'OFF'일 경우에 동작하지 않는다.
# - 'OFF' 상태로 기동시 중복 기동으로 결과 유실 및 중복메시지 전송이 될 수 있습니다
# 이중화를 사용하고 MMS 전송 시엔 NRMSG_DATA 테이블이 참조하는
# XMS_FILE_NAME_1 ~ XMS_FILE_NAME_3 경로 값을 꼭 MASTER, SLAVE 서버 각각에 동일한 경로에 저장하여 사용해야 한다.
# - NAS를 이용한 공유 방식도 가능
#
# ★모듈 이중화 설정(아래 '#'을 삭제 ON 으로 설정)
#duplex_switch = ON

##########################################################################################################
# Active / Stand By 이중화 고유 ID (MASTER, SLAVE | 기본 : SLAVE)
# Active 서버와 Stand By 서버 duplex_id = MASTER/SLAVE 을 동일하게 설정할 경우
# DB 을 동기화할 수 없으므로 정확한 두 서버 간의 이중화를 보장할 수 없다
# 이중화를 사용하고 MMS 전송 시엔 NRMSG_DATA 테이블이 참조하는
# XMS_FILE_NAME_1 ~ XMS_FILE_NAME_3 경로 값을 꼭 MASTER, SLAVE 서버 각각에
# 동일한 경로에 저장하여 사용해야 한다.
# * 모듈 이중화 설정시 필수 항목입니다.
# * 이중화 장비는 반드시 각각 다른 id로 설정.
#duplex_id = MASTER
#duplex_id = SLAVE

##########################################################################################################
# log 기록 범위 설정
# DEBUG : NURI2 의 상세 로그
# FATAL : NURI2 의 치명적 에러
# ERROR : NURI2 가 수행 가능 정도의 에러
# WARN  : NURI2 가 시스템에 문제를 일으킬 가능성이 있을 때 사용
# INFO  : NURI2 의 정보용으로 사용
# ex)loglevel="FATAL","ERROR","WARN","INFO","DEBUG"
#
#console.log_level = INFO
# 로그파일
#system.log_level = DEBUG
#system.log_level = FATAL
#system.log_level = ERROR
#system.log_level = WARN
#system.log_level = INFO
