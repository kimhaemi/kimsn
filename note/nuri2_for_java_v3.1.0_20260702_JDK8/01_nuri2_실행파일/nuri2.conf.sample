##########################################################################################################
# 데이터베이스의 계정 설정 (테이블 생성 권한 필요함)
# Oracle, MSSQL, MySQL, MariaDB, PostgreSQL, CUBRID, Tibero, Altibase, Db2 공통 사용
# * '▶  ◀' 부분을 지우고 입력
#
db_userid = ▶DB 접속 아이디◀
db_password = ▶DB 접속 암호◀

##########################################################################################################
##  DB Pool 세대 선택 옵션 ( 기본 : 7 )
